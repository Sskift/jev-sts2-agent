{
  "name": "sts2-agent-loop",
  "version": "0.1.0",
  "description": "Slay the Spire 2 agent loop using structured mod state, versioned rules and Jev turn planning",
  "main": "src/mod_loop.mjs",
  "type": "module",
  "scripts": {
    "build:driver": "dotnet build native/WindowDriver/WindowDriver.csproj -c Release",
    "window:status": "node src/window_driver.mjs status",
    "mod:state": "node src/mod_client.mjs state",
    "context:preview": "node scripts/context_preview.mjs",
    "context:benchmark": "node scripts/context_benchmark.mjs",
    "start:mod": "node --use-system-ca src/mod_loop.mjs",
    "test": "node --test test/*.test.mjs",
    "replay": "node --use-system-ca scripts/replay_harness.mjs",
    "start": "node --use-system-ca src/mod_loop.mjs"
  },
  "keywords": [
    "slay-the-spire-2",
    "typesafe",
    "jev",
    "agent-loop"
  ],
  "author": "skift",
  "license": "MIT",
  "dependencies": {
    "ajv": "8.20.0"
  }
}
