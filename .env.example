TYPESAFE_API_KEY=
# OpenRouter uses its native Decisions endpoint; direct TypeSafe is also supported.
JEV_PROVIDER=openrouter
# Leave empty for the provider default (OpenRouter: typesafe/jev-1.13).
JEV_MODEL=
OPENROUTER_API_KEY=
# Vercel uses its native evaluation API, not Chat Completions.
# Optional: JEV_PROVIDER=vercel and JEV_MODEL=typesafe-ai/jev.
AI_GATEWAY_API_KEY=
# Optional one-time transport failover; blank disables it.
JEV_FALLBACK_PROVIDER=
JEV_FALLBACK_MODEL=
