TYPESAFE_API_KEY=
# Direct TypeSafe System One endpoint. Jev 1.13 is pinned for reproducibility.
JEV_PROVIDER=typesafe
JEV_MODEL=jev-1.13.0
# Optional cap on paid refinement assessments; blank retains all generated plans.
# 24 samples resource combinations and alternative orders, keeping complete facts.
JEV_PLAN_ASSESSMENT_LIMIT=
# Optional provider: JEV_PROVIDER=openrouter and JEV_MODEL=typesafe/jev-1.13.
OPENROUTER_API_KEY=
# Vercel uses its native evaluation API, not Chat Completions.
# Optional: JEV_PROVIDER=vercel and JEV_MODEL=typesafe-ai/jev.
AI_GATEWAY_API_KEY=
# Optional one-time transport failover; blank disables it.
JEV_FALLBACK_PROVIDER=
JEV_FALLBACK_MODEL=
