diff --git a/STS2.Cli.Mod/Utils/ShopUtils.cs b/STS2.Cli.Mod/Utils/ShopUtils.cs
new file mode 100644
index 0000000..cb0f109
--- /dev/null
+++ b/STS2.Cli.Mod/Utils/ShopUtils.cs
@@ -0,0 +1,60 @@
+using MegaCrit.Sts2.Core.Entities.Merchant;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Events;
+using MegaCrit.Sts2.Core.Nodes;
+using MegaCrit.Sts2.Core.Nodes.CommonUi;
+using MegaCrit.Sts2.Core.Nodes.Events.Custom;
+using MegaCrit.Sts2.Core.Nodes.Rooms;
+using MegaCrit.Sts2.Core.Nodes.Screens.ScreenContext;
+
+namespace STS2.Cli.Mod.Utils;
+
+/// <summary>
+///     Resolves the inventory shared by shop state extraction and purchase actions.
+/// </summary>
+public static class ShopUtils
+{
+    /// <summary>
+    ///     Gets the current merchant room's inventory, or the inventory already bound
+    ///     to an accessible FakeMerchant event UI. Does not open UI or generate stock.
+    /// </summary>
+    /// <param name="canProceed">Whether the current merchant's proceed button is enabled.</param>
+    /// <param name="sourceEvent">The event hosting this shop, or null for an ordinary merchant room.</param>
+    /// <returns>The current local inventory, or null if no shop is accessible.</returns>
+    public static MerchantInventory? GetCurrentInventory(out bool canProceed, out EventModel? sourceEvent)
+    {
+        canProceed = false;
+        sourceEvent = null;
+
+        var eventRoom = NEventRoom.Instance;
+        if (eventRoom != null && eventRoom.IsInsideTree())
+        {
+            if (EventUtils.GetEventModel(eventRoom) is not FakeMerchant { StartedFight: false } eventModel ||
+                eventRoom.CustomEventNode is not NFakeMerchant merchant || !merchant.IsVisibleInTree())
+                return null;
+
+            var inventoryNode = merchant.Inventory;
+            if (inventoryNode?.Inventory == null || !inventoryNode.IsInsideTree()) return null;
+
+            // A closed rug is inspectable only while the merchant can be opened normally.
+            // Once a fight starts, or another screen covers the event, its stock is unavailable.
+            var activeScreen = ActiveScreenContext.Instance.GetCurrentScreen();
+            var merchantButton = merchant.MerchantButton;
+            var canOpen = activeScreen == merchant &&
+                          merchantButton is { IsEnabled: true, IsLocalPlayerDead: false } &&
+                          merchantButton.IsVisibleInTree();
+            if (!(inventoryNode.IsOpen && activeScreen == inventoryNode) && !canOpen) return null;
+
+            var proceedButton = merchant.GetNodeOrNull<NProceedButton>("%ProceedButton");
+            canProceed = proceedButton is { IsEnabled: true } && proceedButton.IsVisibleInTree();
+            sourceEvent = eventModel;
+            return inventoryNode.Inventory;
+        }
+
+        var merchantRoom = NRun.Instance?.MerchantRoom;
+        if (merchantRoom == null || !merchantRoom.IsInsideTree()) return null;
+
+        canProceed = merchantRoom.ProceedButton.IsEnabled;
+        return merchantRoom.Room.GetLocalInventory();
+    }
+}
