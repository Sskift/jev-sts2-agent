+    /// <summary>
+    ///     Waits for a stable, interactive changed page or a transition away from the event.
+    /// </summary>
+    private static async Task<bool> WaitForEventStateChange(
+        NEventRoom eventRoom, string previousState)
+    {
+        string? candidateState = null;
+
+        // PollUntilAsync preserves the Godot synchronization context captured by ExecuteAsync.
+        // All model and scene access therefore stays on the main thread across each delay.
+        return await ActionUtils.PollUntilAsync(() =>
+        {
+            if (!GodotObject.IsInstanceValid(eventRoom) || !eventRoom.IsInsideTree()) return true;
+            if (NOverlayStack.Instance?.Peek() is not null) return true;
+            if (NMapScreen.Instance is { IsOpen: true }) return true;
+
+            var eventModel = EventUtils.GetEventModel(eventRoom);
+            if (eventModel == null) return true;
+
+            var currentState = CaptureEventState(eventModel);
+            if (currentState == previousState || !AreOptionsReady(eventRoom, eventModel))
+            {
+                candidateState = null;
+                return false;
+            }
+
+            // WasChosen and dynamic descriptions can change before the chosen action finishes.
+            // Require the ready page to match on two consecutive polls, not just a changed flag.
+            if (currentState == candidateState) return true;
+            candidateState = currentState;
+            return false;
+        }, ActionUtils.UiTimeoutMs);
+    }
+
+    private static bool AreOptionsReady(NEventRoom eventRoom, EventModel eventModel)
+    {
+        var buttons = eventRoom.Layout?.OptionButtons.ToList();
+        if (buttons == null || buttons.Count == 0 ||
+            buttons.Count != (eventModel.IsFinished ? 1 : eventModel.CurrentOptions.Count)) return false;
+
+        // Native clicks clear/disable the old buttons; the replacement buttons animate in.
+        // Locked options remain visible but are not expected to accept another click.
+        return buttons.All(button => button.IsInsideTree() && button.IsVisibleInTree() &&
+            (button.Option.IsLocked || (button.IsEnabled && button.MouseFilter == Control.MouseFilterEnum.Stop)));
+    }
+
+    private static string CaptureEventState(EventModel eventModel)
+    {
+        // Snapshot only the currently presented page and option content. Titles/count alone
+        // miss repeatable choices whose displayed cost or affected card changes in place.
+        return JsonSerializer.Serialize(new
+        {
+            event_id = eventModel.Id.Entry,
+            title = GetLocText(eventModel.Title),
+            description = GetLocText(eventModel.Description),
+            is_finished = eventModel.IsFinished,
+            options = eventModel.CurrentOptions.Select(option => new
+            {
+                title = GetLocText(option.Title),
+                description = GetLocText(option.Description),
+                text_key = option.TextKey,
+                is_locked = option.IsLocked,
+                is_proceed = option.IsProceed,
+                was_chosen = option.WasChosen,
+                relic_id = option.Relic?.Id.Entry,
+                relic_name = GetLocText(option.Relic?.Title)
+            }).ToArray()
+        });
+    }
+}
