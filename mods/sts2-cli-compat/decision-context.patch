diff --git a/STS2.Cli.Mod/State/Builders/CardAttackPreviewBuilder.cs b/STS2.Cli.Mod/State/Builders/CardAttackPreviewBuilder.cs
new file mode 100644
index 0000000..242e7e7
--- /dev/null
+++ b/STS2.Cli.Mod/State/Builders/CardAttackPreviewBuilder.cs
@@ -0,0 +1,87 @@
+using MegaCrit.Sts2.Core.Commands.Builders;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Hooks;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Cards;
+using STS2.Cli.Mod.Models.State;
+
+namespace STS2.Cli.Mod.State.Builders;
+
+/// <summary>
+///     Exposes verified native attack counts without playing cards or executing attacks.
+/// </summary>
+public static class CardAttackPreviewBuilder
+{
+    /// <summary>
+    ///     Builds a current-state preview only for cards whose native attack construction is known.
+    ///     Unsupported cards and failures remain unknown rather than assuming a single hit.
+    /// </summary>
+    public static CardAttackPreviewDto? Build(CardModel card)
+    {
+        try
+        {
+            if (card is not (Conflagration or TwinStrike or Whirlwind) ||
+                card.Type != CardType.Attack || card.CombatState is not { } combat)
+                return null;
+
+            int hits;
+            int? energyToSpend = null;
+            switch (card)
+            {
+                case Conflagration when card.TargetType == TargetType.AllEnemies:
+                    hits = card.DynamicVars.Repeat.IntValue;
+                    break;
+                case TwinStrike when card.TargetType == TargetType.AnyEnemy:
+                    hits = 2; // Native TwinStrike.OnPlay uses WithHitCount(2), including its upgrade.
+                    break;
+                case Whirlwind when card.TargetType == TargetType.AllEnemies && card.EnergyCost.CostsX:
+                    energyToSpend = card.EnergyCost.GetAmountToSpend();
+                    // CapturedXValue belongs to a previous payment, not the current hand preview.
+                    hits = Hook.ModifyXValue(combat, card, energyToSpend.Value);
+                    break;
+                default:
+                    return null;
+            }
+
+            // These setters only configure a detached command. Never call Execute or BeforeAttack.
+            // Native hit-count hooks are read-only; card-play and between-hit effects are not simulated.
+            AttackCommand CreateAttack() => new AttackCommand(card.DynamicVars.Damage.BaseValue)
+                .FromCard(card, null).WithHitCount(hits);
+
+            decimal? modifiedHits = null;
+            if (card.TargetType == TargetType.AllEnemies)
+            {
+                modifiedHits = Hook.ModifyAttackHitCount(combat, CreateAttack().TargetingAllOpponents(combat), hits);
+            }
+            else
+            {
+                // A card-level count must be valid for every currently selectable enemy.
+                foreach (var enemy in combat.HittableEnemies)
+                {
+                    if (!card.CanPlayTargeting(enemy))
+                        continue;
+                    var targetHits = Hook.ModifyAttackHitCount(combat, CreateAttack().Targeting(enemy), hits);
+                    if (modifiedHits.HasValue && modifiedHits.Value != targetHits)
+                        return null;
+                    modifiedHits = targetHits;
+                }
+            }
+
+            if (!modifiedHits.HasValue)
+                return null;
+
+            return new CardAttackPreviewDto
+            {
+                Hits = checked((int)Math.Max(0m, modifiedHits.Value)),
+                EnergyToSpend = energyToSpend,
+                Scope = "Current-state preview of hits per targeted enemy, not a guarantee of final execution. " +
+                        "Resource-spend, card-play, pre-attack, between-hit, death, and combat-end effects are not simulated."
+            };
+        }
+        catch (Exception ex)
+        {
+            DecisionContextBuilder.Report($"card attack preview: {ex.GetType().Name}");
+            return null;
+        }
+    }
+}
