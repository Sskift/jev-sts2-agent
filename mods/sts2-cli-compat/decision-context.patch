diff --git a/STS2.Cli.Mod/State/Builders/CardUpgradePreviewBuilder.cs b/STS2.Cli.Mod/State/Builders/CardUpgradePreviewBuilder.cs
new file mode 100644
index 0000000..9119c80
--- /dev/null
+++ b/STS2.Cli.Mod/State/Builders/CardUpgradePreviewBuilder.cs
@@ -0,0 +1,90 @@
+using System.Reflection;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Models;
+using STS2.Cli.Mod.Models.State;
+using STS2.Cli.Mod.Utils;
+using static STS2.Cli.Mod.Utils.TextUtils;
+
+namespace STS2.Cli.Mod.State.Builders;
+
+/// <summary>
+///     Builds the player's inspectable upgrade preview without modifying or registering a live card.
+/// </summary>
+public static class CardUpgradePreviewBuilder
+{
+    private static readonly ModLogger Logger = new("CardUpgradePreviewBuilder");
+    private static readonly MethodInfo? ShallowCloneMethod = typeof(object).GetMethod(
+        "MemberwiseClone", BindingFlags.Instance | BindingFlags.NonPublic);
+
+    /// <summary>
+    ///     Upgrades a detached copy using the native preview path. Returns null for cards that
+    ///     cannot upgrade or whose preview could not be extracted. Call on the Godot main thread.
+    /// </summary>
+    /// <remarks>
+    ///     Matches untargeted upgrade inspection, not a counterfactual play: no upgrade/play hooks,
+    ///     target modifiers, prior preparation effects, or later triggers are simulated. The native
+    ///     detached preview retains Owner and uses Combat preview mode for combat piles, allowing
+    ///     current combat dynamic variables and preview hooks without registering a card.
+    /// </remarks>
+    public static CardUpgradePreviewDto? Build(CardModel card)
+    {
+        try
+        {
+            if (!card.IsUpgradable) return null;
+
+            // Match NUpgradePreview/NCard on a detached model. CardScope.CloneCard
+            // registers a new card in live state, so it is unsuitable for a state read.
+            var preview = DetachedClone(card);
+            preview.UpgradeInternal();
+            preview.UpgradePreviewType = card.Pile?.IsCombatPile == true
+                ? CardUpgradePreviewType.Combat
+                : CardUpgradePreviewType.Deck;
+            preview.DynamicVars.ClearPreview();
+            preview.UpdateDynamicVarPreview(CardPreviewMode.Upgrade, null, preview.DynamicVars);
+            if (preview.Enchantment is { } enchantment)
+            {
+                enchantment.DynamicVars.ClearPreview();
+                preview.UpdateDynamicVarPreview(CardPreviewMode.Upgrade, null, enchantment.DynamicVars);
+            }
+
+            return new CardUpgradePreviewDto
+            {
+                Name = StripGameTags(preview.Title),
+                Description = StripGameTags(preview.GetDescriptionForUpgradePreview()),
+                Cost = preview.EnergyCost.CostsX ? -1 : preview.EnergyCost.GetWithModifiers(CostModifiers.All),
+                StarCost = preview.CanonicalStarCost < 0 ? null
+                    : preview.HasStarCostX ? -1 : preview.GetStarCostWithModifiers()
+            };
+        }
+        catch (Exception ex)
+        {
+            DecisionContextBuilder.Report($"card {card.Id.Entry} upgrade preview: {ex.GetType().Name}");
+            Logger.Warning($"Failed to build upgrade preview for '{card.Id.Entry}': {ex.Message}");
+            return null;
+        }
+    }
+
+    private static CardModel DetachedClone(CardModel card)
+    {
+        // Native MutableClone deep-clones enchantments and afflictions before AfterCloned
+        // clears delegates. Those setters may otherwise notify the live card's subscribers.
+        // Clear event fields on a shallow, unregistered staging object first; native cloning
+        // then supplies the independent variables, costs, enchantments, and afflictions.
+        var staging = (CardModel)(ShallowCloneMethod?.Invoke(card, null)
+            ?? throw new MissingMethodException("Card preview requires MemberwiseClone"));
+        for (var type = card.GetType(); type != null; type = type.BaseType)
+        {
+            const BindingFlags flags = BindingFlags.Instance | BindingFlags.Public |
+                                       BindingFlags.NonPublic | BindingFlags.DeclaredOnly;
+            foreach (var eventInfo in type.GetEvents(flags))
+            {
+                var field = type.GetField(eventInfo.Name, flags);
+                if (field == null || !typeof(Delegate).IsAssignableFrom(field.FieldType))
+                    throw new MissingFieldException(type.FullName, eventInfo.Name);
+                field.SetValue(staging, null);
+            }
+        }
+
+        return (CardModel)staging.MutableClone();
+    }
+}
