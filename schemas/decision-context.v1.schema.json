{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jev-sts2-agent:decision-context:v1",
  "title": "STS2 self-contained Jev decision context",
  "description": "Internal canonical decision state, compiled losslessly into the model-facing v2 domains. Contains every referenced text and offered action parameter.",
  "type": "object",
  "required": [
    "schema_version",
    "objective",
    "screen",
    "in_combat",
    "run",
    "player",
    "resources",
    "deck",
    "map",
    "combat",
    "screen_state",
    "memory",
    "rules",
    "information",
    "legal_actions"
  ],
  "additionalProperties": false,
  "properties": {
    "strategy_knowledge": { "type": ["object", "null"] },
    "run_strategy": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["source", "is_observed_fact", "run_id", "revision", "basis", "freshness", "development_priority", "anchor", "capability_assessment", "revisions", "scope"],
      "properties": {
        "source": { "const": "persisted_jev_judgment" }, "is_observed_fact": { "const": false },
        "run_id": { "type": "string" }, "revision": { "type": "integer", "minimum": 1 },
        "basis": {
          "type": "object", "additionalProperties": false, "required": ["run_id", "act_index", "floor", "checkpoint", "build_id"],
          "properties": { "run_id": { "type": "string" }, "act_index": { "type": "integer", "minimum": 0 },
            "floor": { "type": "integer", "minimum": 0 }, "checkpoint": { "type": "string" }, "build_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
            "structure_id": { "type": "string", "pattern": "^[a-f0-9]{24}$" } }
        },
        "revision_coverage": { "type": "object", "additionalProperties": false,
          "required": ["policy", "assessments_archived", "intention_changes_included", "scope"],
          "properties": { "policy": { "enum": ["current_assessment_and_all_intention_changes", "current_assessment_only_in_combat"] },
            "assessments_archived": { "type": "integer", "minimum": 0 },
            "intention_changes_included": { "type": "integer", "minimum": 0 }, "scope": { "$ref": "#/$defs/text" } } },
        "freshness": { "type": "object", "additionalProperties": false, "required": ["needs_review", "reason"],
          "properties": { "needs_review": { "type": "boolean" }, "deferred_until_post_combat": { "type": "boolean" },
            "reason": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] } } },
        "development_priority": { "type": "object", "required": ["id", "meaning", "confidence"],
          "properties": { "id": { "enum": ["single_target_damage", "multiple_enemy_control", "sustained_defense", "long_fight_scaling", "draw_consistency", "energy_efficiency", "recovery", "preserve_flexibility"] },
            "meaning": { "$ref": "#/$defs/text" }, "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } } },
        "anchor": { "type": "object", "required": ["kind", "id", "name", "confidence"],
          "properties": { "kind": { "enum": ["card", "relic", "none"] }, "id": { "type": ["string", "null"] },
            "name": { "$ref": "#/$defs/text" }, "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } } },
        "capability_assessment": { "type": "object", "required": ["scale", "dimensions", "ratings"],
          "properties": { "scale": { "$ref": "#/$defs/text" }, "dimensions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/text" } },
            "ratings": { "type": "object", "additionalProperties": false,
              "required": ["single_target_damage", "multiple_enemy_control", "sustained_defense", "long_fight_scaling", "draw_consistency", "energy_efficiency", "recovery"],
              "properties": {
                "single_target_damage": { "$ref": "#/$defs/strategicRating" }, "multiple_enemy_control": { "$ref": "#/$defs/strategicRating" },
                "sustained_defense": { "$ref": "#/$defs/strategicRating" }, "long_fight_scaling": { "$ref": "#/$defs/strategicRating" },
                "draw_consistency": { "$ref": "#/$defs/strategicRating" }, "energy_efficiency": { "$ref": "#/$defs/strategicRating" },
                "recovery": { "$ref": "#/$defs/strategicRating" }
              } } } },
        "revisions": { "$ref": "#/$defs/records" }, "scope": { "$ref": "#/$defs/text" }
      }
    },
    "turn_plan": {
      "type": ["object", "null"],
      "required": ["source", "revision", "turn", "objective", "status", "next_step", "ordered_steps"],
      "properties": {
        "source": { "$ref": "#/$defs/text" },
        "revision": { "type": "integer", "minimum": 0 },
        "turn": { "type": "integer", "minimum": 0 },
        "objective": { "type": "object", "required": ["id", "meaning"], "properties": { "id": { "type": "string" }, "meaning": { "$ref": "#/$defs/text" } } },
        "status": { "enum": ["active", "awaiting_selection", "needs_review", "completed", "outcome_unknown"] },
        "next_step": { "type": "integer", "minimum": 0 },
        "ordered_steps": { "type": "array", "items": {
          "type": "object", "required": ["sequence", "kind", "role", "status"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 0 },
            "kind": { "enum": ["play_card", "use_potion", "end_turn"] },
            "role": { "enum": ["payoff", "preparation", "finish_turn"] },
            "status": { "enum": ["confirmed", "intended"] }
          }
        } }
      }
    },
    "turn_planning": { "type": "object", "required": ["phase_scope", "energy_reservation"], "properties": {
      "phase_scope": { "$ref": "#/$defs/text" },
      "action_reservation": { "type": "object", "required": ["is_observed", "valid", "constraints", "transitions", "scope"],
        "properties": { "is_observed": { "const": false }, "valid": { "type": "boolean" },
          "constraints": { "type": "array", "items": { "type": "object", "required": ["rule_id", "affected_card_instance_ids", "maximum_prior_card_starts"],
            "properties": { "rule_id": { "type": "string" }, "affected_card_instance_ids": { "type": "array", "items": { "type": "string" } }, "maximum_prior_card_starts": { "type": "integer", "minimum": 0 } } } },
          "transitions": { "type": "array", "items": { "type": "object", "required": ["sequence", "kind", "card_instance_id", "card_starts_before", "card_starts_after", "allowed", "violated_rules"],
            "properties": { "sequence": { "type": "integer", "minimum": 0 }, "kind": { "enum": ["play_card", "use_potion", "end_turn"] },
              "card_instance_id": { "type": ["string", "null"] }, "card_starts_before": { "type": "integer", "minimum": 0 }, "card_starts_after": { "type": "integer", "minimum": 0 },
              "allowed": { "type": "boolean" }, "violated_rules": { "type": "array", "items": { "type": "string" } } } } }, "scope": { "$ref": "#/$defs/text" } } },
      "survival_constraints": { "type": "array", "items": { "type": "object", "required": ["kind"],
        "properties": { "kind": { "enum": ["potential_lethal_health_loss", "observed_loss_countdown", "explicit_loss_rule"] } } } },
      "comparisons": { "type": "array", "minItems": 1, "maxItems": 32, "items": {
        "type": "object", "additionalProperties": false, "required": ["plan_a", "plan_b"],
        "properties": { "plan_a": { "type": "object" }, "plan_b": { "type": "object" }, "continuation_resources": { "type": "object" } }
      } },
      "assessments": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object" } },
      "conditional_projection": { "oneOf": [{ "$ref": "#/$defs/turnProjection" }, { "type": "array", "maxItems": 0 }] },
      "energy_reservation": { "type": "object", "additionalProperties": false, "required": ["observed_energy", "remaining_after_printed_costs", "scope", "is_observed", "includes_future_energy_gains", "steps"], "properties": {
        "observed_energy": { "type": "integer", "minimum": 0 },
        "remaining_after_printed_costs": { "type": "integer" },
        "is_observed": { "type": "boolean" },
        "includes_future_energy_gains": { "const": false },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/energyTransition" } },
        "scope": { "$ref": "#/$defs/text" }
      } }
    } },
    "decision_brief": { "type": ["object", "null"] },
    "rule_reference": {
      "type": ["object", "null"],
      "properties": {
        "source": { "$ref": "#/$defs/text" },
        "game_version": { "type": "string" },
        "scope": { "$ref": "#/$defs/text" },
        "entries": { "type": "object" }
      }
    },
    "strategy_assessment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source", "priority", "meaning"],
          "properties": {
            "source": { "$ref": "#/$defs/text" },
            "priority": { "enum": ["reliable_defense", "efficient_damage", "multi_target_damage", "sustained_scaling", "draw_consistency", "energy_support", "immediate_recovery", "preserve_quality"] },
            "meaning": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "required": ["source", "scale", "options"],
          "properties": {
            "source": { "$ref": "#/$defs/text" },
            "scale": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/text" } },
            "options": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "required": ["action_id", "score"],
                "properties": {
                  "action_id": { "type": "string", "minLength": 1 },
                  "score": { "type": "number", "minimum": 0, "maximum": 3 },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                  "probabilities": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
                }
              }
            }
          }
        }
      ]
    },
    "schema_version": {
      "const": "sts2.decision.v1"
    },
    "objective": {
      "type": "object",
      "required": [
        "strategy",
        "execution_checkpoint"
      ],
      "properties": {
        "strategy": {
          "$ref": "#/$defs/text"
        },
        "execution_checkpoint": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "screen": {
      "type": "string"
    },
    "in_combat": {
      "type": "boolean"
    },
    "run": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "run_id",
            "combat_id",
            "act_index",
            "act_floor",
            "total_floor",
            "ascension",
            "game_mode",
            "modifiers"
          ],
          "properties": {
            "run_id": {
              "type": "string"
            },
            "combat_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "act_index": {
              "type": "integer",
              "minimum": 0
            },
            "act_floor": {
              "type": "integer",
              "minimum": 0
            },
            "total_floor": {
              "type": "integer",
              "minimum": 0
            },
            "ascension": {
              "type": "integer",
              "minimum": 0
            },
            "game_mode": {
              "type": "string"
            },
            "modifiers": {
              "type": "array"
            }
          }
        }
      ]
    },
    "player": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "hp",
            "max_hp",
            "gold",
            "deck_count",
            "relics",
            "potions",
            "powers"
          ],
          "properties": {
            "hp": {
              "type": "number"
            },
            "max_hp": {
              "type": "number"
            },
            "gold": {
              "type": "number"
            },
            "deck_count": {
              "type": "integer",
              "minimum": 0
            },
            "relics": {
              "type": "array"
            },
            "potions": {
              "type": "array"
            },
            "powers": {
              "type": "array"
            }
          }
        }
      ]
    },
    "resources": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "potion_capacity"
          ],
          "properties": {
            "potion_capacity": {
              "type": "integer",
              "minimum": 0
            },
            "potion_effects": { "type": "array", "items": { "$ref": "#/$defs/potionEffect" } }
          }
        }
      ]
    },
    "deck": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "count",
            "cards",
            "kind"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "cards": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/cardGroup"
                  }
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "kind": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "map": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "act_index",
            "nodes"
          ],
          "dependentRequired": {
            "legal_next_nodes": ["routes", "route_semantics"],
            "routes": ["legal_next_nodes", "route_semantics"]
          },
          "properties": {
            "act_index": {
              "type": "integer"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "col",
                  "row",
                  "type",
                  "children"
                ],
                "properties": {
                  "col": {
                    "type": "integer"
                  },
                  "row": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string"
                  },
                  "children": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/coord"
                    }
                  }
                }
              }
            },
            "legal_next_nodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/coord"
              }
            },
            "routes": {
              "type": "array",
              "items": { "$ref": "#/$defs/mapRoute" }
            },
            "route_semantics": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "combat": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "hand",
            "draw_pile",
            "discard_pile",
            "exhaust_pile",
            "play_pile",
            "enemies",
            "history",
            "history_coverage"
          ],
          "properties": {
            "effect_timing": { "$ref": "#/$defs/combatEffects" },
            "observed_progress": {
              "type": "object",
              "required": ["current_round", "history_coverage", "enemies", "scope"],
              "properties": {
                "current_round": { "type": "integer", "minimum": 0 },
                "history_coverage": { "$ref": "#/$defs/text" },
                "scope": { "$ref": "#/$defs/text" },
                "enemies": {
                  "oneOf": [
                    { "$ref": "#/$defs/recordTable" },
                    { "type": "array", "items": {
                      "type": "object",
                      "required": ["combat_id", "role", "current_hp", "recorded_damage_events", "recorded_hp_damage", "recorded_overkill", "last_damaged_round", "observed_hp_depletions"],
                      "properties": {
                        "combat_id": { "type": "integer" },
                        "role": { "enum": ["minion", "not_identified_as_minion"] },
                        "current_hp": { "type": "number", "minimum": 0 },
                        "recorded_damage_events": { "type": "integer", "minimum": 0 },
                        "recorded_hp_damage": { "type": ["number", "null"], "minimum": 0 },
                        "recorded_overkill": { "type": ["number", "null"], "minimum": 0 },
                        "last_damaged_round": { "type": ["integer", "null"], "minimum": 0 },
                        "observed_hp_depletions": { "type": ["integer", "null"], "minimum": 0 }
                      }
                    } }
                  ]
                }
              }
            },
            "hand": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/card"
                  }
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "draw_pile": {
              "type": "object",
              "required": [
                "order",
                "cards"
              ],
              "properties": {
                "order": {
                  "const": "unknown"
                },
                "cards": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/cardGroup"
                      }
                    },
                    {
                      "$ref": "#/$defs/recordTable"
                    }
                  ]
                }
              }
            },
            "discard_pile": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/card"
                  }
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "exhaust_pile": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/card"
                  }
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "play_pile": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/card"
                  }
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "enemies": {
              "oneOf": [
                {
                  "type": "array"
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "history": {
              "$ref": "#/$defs/records"
            },
            "history_coverage": {
              "$ref": "#/$defs/text"
            },
            "positioning": {
              "$ref": "#/$defs/positioning"
            }
          }
        }
      ]
    },
    "screen_state": {
      "type": "object",
      "description": "Exact current menu, event, shop, reward or selection DTO, including offered effects and selection constraints."
    },
    "memory": {
      "type": "object",
      "required": [
        "coverage",
        "actions",
        "observations"
      ],
      "properties": {
        "coverage": {
          "$ref": "#/$defs/text"
        },
        "actions": {
          "$ref": "#/$defs/records"
        },
        "observations": {
          "$ref": "#/$defs/records"
        },
        "relic_updates": {
          "$ref": "#/$defs/records"
        },
        "pending": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/text"
          },
          "description": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "information": {
      "type": "object",
      "required": [
        "source",
        "unknown",
        "card_grouping",
        "extraction_errors"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/text"
        },
        "unknown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "card_grouping": {
          "$ref": "#/$defs/text"
        },
        "extraction_errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "legal_actions": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action_id",
              "request",
              "description"
            ],
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "$ref": "#/$defs/text"
              },
              "card_hand_index": {
                "type": "integer",
                "minimum": 0
              },
              "target_combat_id": {
                "type": "integer",
                "minimum": 0
              },
              "planning_choice": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "count"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "count"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "card_index"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "card"
                      },
                      "card_index": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                ]
              },
              "request": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "cmd"
                ],
                "properties": {
                  "cmd": {
                    "type": "string",
                    "pattern": "^[a-z][a-z_]*$"
                  }
                }
              }
            }
          }
        },
        {
          "$ref": "#/$defs/recordTable"
        }
      ]
    },
    "text_dictionary": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "strategicRating": {
      "type": "object", "additionalProperties": false, "required": ["score", "confidence"],
      "properties": { "score": { "type": "number", "minimum": 0, "maximum": 3 }, "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } }
    },
    "positioning": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "player_combat_id", "facing", "back_attack_multiplier", "intents_include_current_facing", "enemies", "targeting_rule", "death_rule", "preview_scope"],
      "properties": {
        "source": { "const": "native_visible_surrounded_state" },
        "player_combat_id": { "type": "integer" },
        "facing": { "enum": ["Left", "Right"] },
        "back_attack_multiplier": { "const": 1.5 },
        "intents_include_current_facing": { "const": true },
        "enemies": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["combat_id", "side", "attacking_from_behind"],
          "properties": { "combat_id": { "type": "integer" }, "side": { "enum": ["Left", "Right", "None"] }, "attacking_from_behind": { "type": "boolean" } }
        } },
        "targeting_rule": { "$ref": "#/$defs/text" }, "death_rule": { "$ref": "#/$defs/text" }, "preview_scope": { "$ref": "#/$defs/text" }
      }
    },
    "positioningProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["is_observed", "observed_facing", "facing_after_sequence", "current_intents_still_applicable", "enemies_after_sequence", "scope"],
      "properties": {
        "is_observed": { "const": false },
        "observed_facing": { "enum": ["Left", "Right"] }, "facing_after_sequence": { "enum": ["Left", "Right"] },
        "current_intents_still_applicable": { "type": "boolean" },
        "enemies_after_sequence": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["combat_id", "side", "attacking_from_behind", "facing_damage_multiplier"],
          "properties": { "combat_id": { "type": "integer" }, "side": { "enum": ["Left", "Right", "None"] }, "attacking_from_behind": { "type": "boolean" }, "facing_damage_multiplier": { "enum": [1, 1.5] } }
        } },
        "scope": { "$ref": "#/$defs/text" }
      }
    },
    "turnProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["calculation_status", "fully_simulated", "known_effects_only", "omitted_effects", "interpretation", "scope"],
      "properties": {
        "calculation_status": { "enum": ["incomplete", "preview_arithmetic"] },
        "fully_simulated": { "const": false },
        "known_effects_only": {
          "type": "object", "additionalProperties": false,
          "required": ["block", "hp_if_ending", "hp_loss_if_ending", "block_including_end_turn_gains", "end_turn_block_gains", "incoming_attack", "enemies"],
          "properties": {
            "block": { "type": ["number", "null"] }, "hp_if_ending": { "type": ["number", "null"] }, "hp_loss_if_ending": { "type": ["number", "null"] },
            "block_including_end_turn_gains": { "type": ["number", "null"] }, "incoming_attack": { "type": ["number", "null"] },
            "end_turn_block_gains": { "type": "array", "items": {
              "type": "object", "required": ["source_id", "amount", "timing"],
              "properties": { "source_id": { "type": "string" }, "amount": { "type": "number", "minimum": 0 }, "timing": { "$ref": "#/$defs/text" } }
            } },
            "end_turn_damage_events": { "type": "array", "items": { "type": "object", "required": ["source_id", "amount", "timing", "damage_kind", "condition"],
              "properties": { "source_id": { "type": "string" }, "amount": { "type": "number", "minimum": 0 }, "timing": { "$ref": "#/$defs/text" }, "damage_kind": { "$ref": "#/$defs/text" }, "condition": { "$ref": "#/$defs/text" } } } },
            "enemies": { "type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["combat_id", "hp", "block", "hp_removed", "block_removed"],
              "properties": {
                "combat_id": { "type": "integer" }, "hp": { "type": ["number", "null"] }, "block": { "type": ["number", "null"] },
                "hp_removed": { "type": ["number", "null"] }, "block_removed": { "type": ["number", "null"] },
                "conditional_bounds": { "type": "object", "additionalProperties": false, "required": ["hp", "hp_removed", "block"],
                  "properties": { "hp": { "$ref": "#/$defs/conditionalCount" }, "hp_removed": { "$ref": "#/$defs/conditionalCount" }, "block": { "$ref": "#/$defs/conditionalCount" } } },
                "power_changes": { "type": "array", "items": { "type": "object", "required": ["power_id", "before", "after_declared_actions"],
                  "properties": { "power_id": { "type": "string" }, "before": { "type": "number" }, "after_declared_actions": { "$ref": "#/$defs/conditionalCount" } } } }
              }
            } }
          }
        },
        "checkpoint_attack_balance": {
          "type": "object", "additionalProperties": false,
          "required": ["is_end_turn_prediction", "energy_after_known_payments", "hp_after_declared_self_loss", "block_from_known_prefix", "current_attack_after_known_prefix", "attack_damage_not_covered_by_known_block", "hp_margin_against_current_attacks", "additional_attack_mitigation_to_leave_positive_hp", "scope"],
          "properties": {
            "is_end_turn_prediction": { "const": false }, "energy_after_known_payments": { "type": "number" },
            "hp_after_declared_self_loss": { "type": ["number", "null"] }, "block_from_known_prefix": { "type": ["number", "null"] },
            "current_attack_after_known_prefix": { "type": ["number", "null"] }, "attack_damage_not_covered_by_known_block": { "type": ["number", "null"] },
            "hp_margin_against_current_attacks": { "type": ["number", "null"] }, "additional_attack_mitigation_to_leave_positive_hp": { "type": ["number", "null"] },
            "scope": { "$ref": "#/$defs/text" }
          }
        },
        "encounter_progress": { "type": "array", "items": { "type": "object" } },
        "uncomputed_depletion_effects": { "type": "array", "items": { "type": "object" } },
        "uncomputed_death_prevention": { "type": "array", "items": { "type": "object" } },
        "sequence_dependencies": { "type": "object", "required": ["is_observed", "steps", "checkpoint", "violations", "scope"],
          "properties": { "is_observed": { "const": false }, "steps": { "type": "array" }, "checkpoint": { "type": ["object", "null"] }, "violations": { "type": "array" }, "scope": { "$ref": "#/$defs/text" } } },
        "loss_deadlines": { "type": "array", "items": { "type": "object", "required": ["source_id", "owner_combat_id", "counter_after_declared_actions", "counter_after_upcoming_enemy_start", "enemy_starts_until_lethal_without_further_changes", "known_delay_cards", "scope"],
          "properties": { "source_id": { "type": "string" }, "owner_combat_id": { "type": "integer" }, "counter_after_declared_actions": { "type": "integer" }, "counter_after_upcoming_enemy_start": { "type": ["integer", "null"] }, "enemy_starts_until_lethal_without_further_changes": { "type": "integer" }, "known_delay_cards": { "type": "object" }, "scope": { "$ref": "#/$defs/text" } } } },
        "positioning": { "$ref": "#/$defs/positioningProjection" },
        "uncomputed_turn_end_effects": { "type": "array", "items": { "type": "object", "required": ["category", "source_id", "description", "timing", "condition_evaluated", "affected_outputs", "scope"],
          "properties": { "category": { "enum": ["power", "relic", "hand_card", "pile_card"] }, "source_id": { "type": "string" }, "description": { "$ref": "#/$defs/text" }, "scope": { "$ref": "#/$defs/text" }, "condition_evaluated": { "type": "boolean" },
            "timing": { "$ref": "#/$defs/text" }, "affected_outputs": { "type": "array", "items": { "$ref": "#/$defs/text" } } } } },
        "effect_lifecycle": { "type": "object", "required": ["is_observed_effect", "next_card_triggers", "scope"],
          "properties": { "is_observed_effect": { "const": false }, "next_card_triggers": { "type": "array" }, "scope": { "$ref": "#/$defs/text" } } },
        "debuff_dependencies": { "type": "object", "required": ["is_observed_effect", "adapters", "affected_target_ids", "transitions", "ordered_damage", "enemies", "scope"],
          "properties": { "is_observed_effect": { "const": false }, "adapters": { "type": "array", "items": { "type": "string" } },
            "affected_target_ids": { "type": "array", "items": { "type": "integer" } }, "transitions": { "type": "array" }, "ordered_damage": { "type": "array" }, "scope": { "$ref": "#/$defs/text" },
            "enemies": { "type": "array", "items": { "type": "object", "required": ["combat_id", "hp_remaining", "depleted_if_all_declared_hits_resolve", "current_attack_after_debuffs"],
              "properties": { "combat_id": { "type": "integer" }, "hp_remaining": { "$ref": "#/$defs/conditionalCount" }, "depleted_if_all_declared_hits_resolve": { "type": ["boolean", "null"] }, "current_attack_after_debuffs": { "$ref": "#/$defs/conditionalCount" } } } } } },
        "card_flow": { "type": "object", "required": ["is_observed_effect", "observed_draw_pile", "generated_into_draw_pile", "effects", "scope"],
          "properties": { "is_observed_effect": { "const": false }, "observed_draw_pile": { "type": "object" },
            "generated_into_draw_pile": { "$ref": "#/$defs/conditionalCount" }, "scope": { "$ref": "#/$defs/text" },
            "effects": { "type": "array", "items": { "type": "object", "required": ["sequence", "source_id", "owner_combat_ids", "played_card_id", "generated_card_id", "destination", "placement", "preview_hits", "added_if_all_preview_hits_resolve"],
              "properties": { "sequence": { "type": "integer", "minimum": 0 }, "source_id": { "type": "string" },
                "owner_combat_ids": { "type": "array", "items": { "type": "integer" } }, "played_card_id": { "type": "string" }, "generated_card_id": { "type": "string" },
                "destination": { "const": "draw_pile" }, "placement": { "const": "random" }, "preview_hits": { "type": ["integer", "null"], "minimum": 0 },
                "added_if_all_preview_hits_resolve": { "$ref": "#/$defs/conditionalCount" } } } } } },
        "uncomputed_reactions": { "type": "array", "items": { "type": "object", "required": ["source_id", "owner_combat_id", "sequence", "timing", "damage_per_trigger", "preview_hits", "affected_outputs"],
          "properties": { "source_id": { "type": "string" }, "owner_combat_id": { "type": "integer" }, "sequence": { "type": "integer", "minimum": 0 },
            "timing": { "$ref": "#/$defs/text" }, "damage_per_trigger": { "type": "number", "minimum": 0 }, "preview_hits": { "type": ["integer", "null"], "minimum": 0 },
            "affected_outputs": { "type": "array", "items": { "$ref": "#/$defs/text" } } } } },
        "omitted_effects": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "interpretation": { "$ref": "#/$defs/text" }, "scope": { "$ref": "#/$defs/text" }
      }
    },
    "conditionalCount": { "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": { "min": { "type": ["integer", "null"], "minimum": 0 }, "max": { "type": ["integer", "null"], "minimum": 0 } } },
    "combatEffects": {
      "type": "object", "additionalProperties": false, "required": ["game_version", "effects", "scope", "phase_order"],
      "properties": {
        "game_version": { "const": "v0.111.0" }, "scope": { "$ref": "#/$defs/text" },
        "phase_order": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "effects": { "type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["source_id", "category", "owner", "active", "live_rule", "wiki_rule_id", "activation", "trigger", "expires", "timing_coverage"],
          "properties": {
            "source_id": { "type": "string" }, "category": { "enum": ["powers", "cards", "potions", "relics"] },
            "owner": { "oneOf": [{ "type": "integer" }, { "const": "player" }] }, "active": { "type": "boolean" },
            "card_instance_id": { "type": "string" }, "potion_slot": { "type": "integer", "minimum": 0 }, "current_amount": { "type": "number" },
            "live_rule": { "$ref": "#/$defs/text" }, "wiki_rule_id": { "type": ["string", "null"] },
            "activation": { "enum": ["already_present", "after_play", "after_use", "enters_required_pile"] },
            "observed_pile": { "type": "string" }, "required_pile": { "type": "string" }, "trigger_condition": { "$ref": "#/$defs/text" },
            "trigger": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
            "expires": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/text" }] },
            "consequence": { "$ref": "#/$defs/text" }, "timing_detail": { "$ref": "#/$defs/text" }, "timing_coverage": { "$ref": "#/$defs/text" },
            "followup": { "$ref": "#/$defs/text" }, "amount_after_use": { "type": "number" }, "retroactive": { "const": false }
          }
        } }
      }
    },
    "potionEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["potion_id", "slot", "power_id", "amount", "duration", "expires_at", "can_be_changed_or_removed", "affected_quantity", "application_unit", "applied_before_multipliers", "affects_prior_actions", "direct_damage", "direct_block", "requires_followup_actions", "unpowered_effects_excluded", "source"],
      "properties": {
        "potion_id": { "enum": ["STRENGTH_POTION", "DEXTERITY_POTION", "FLEX_POTION", "SPEED_POTION"] },
        "slot": { "type": "integer", "minimum": 0 },
        "power_id": { "enum": ["STRENGTH_POWER", "DEXTERITY_POWER"] },
        "amount": { "type": "integer", "minimum": 0 },
        "duration": { "enum": ["combat", "turn"] },
        "expires_at": { "enum": ["combat_end", "owner_turn_end"] },
        "can_be_changed_or_removed": { "const": true },
        "affected_quantity": { "enum": ["powered_attack_damage", "powered_block_gain"] },
        "application_unit": { "enum": ["each_damage_instance", "each_block_gain"] },
        "applied_before_multipliers": { "const": true },
        "affects_prior_actions": { "const": false },
        "direct_damage": { "const": 0 },
        "direct_block": { "const": 0 },
        "requires_followup_actions": { "const": true },
        "unpowered_effects_excluded": { "const": true },
        "source": { "$ref": "#/$defs/text" }
      }
    },
    "energyTransition": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "kind", "hand_index", "energy_before", "reserved_cost", "energy_after", "affordable"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["play_card", "use_potion", "end_turn"] },
        "hand_index": { "type": ["integer", "null"], "minimum": 0 },
        "energy_before": { "type": "integer" },
        "reserved_cost": { "type": "integer", "minimum": 0 },
        "energy_after": { "type": "integer" },
        "affordable": { "type": "boolean" }
      }
    },
    "nodeCountRange": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": { "min": { "type": "integer", "minimum": 0 }, "max": { "type": "integer", "minimum": 0 } }
    },
    "mapRoute": {
      "type": "object", "additionalProperties": false,
      "required": ["next_node", "reachable_node_count", "nearest_steps_after_chosen_node", "reaches_boss", "counts", "route_examples", "minimum_elite_route_example", "known_elite_required_to_reach_boss"],
      "properties": {
        "next_node": { "$ref": "#/$defs/coord" },
        "reachable_node_count": { "type": "integer", "minimum": 1 },
        "nearest_steps_after_chosen_node": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "reaches_boss": { "type": "boolean" },
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["MONSTER", "ELITE", "REST_SITE", "SHOP", "TREASURE", "UNKNOWN", "BOSS"],
          "properties": {
            "MONSTER": { "$ref": "#/$defs/nodeCountRange" }, "ELITE": { "$ref": "#/$defs/nodeCountRange" },
            "REST_SITE": { "$ref": "#/$defs/nodeCountRange" }, "SHOP": { "$ref": "#/$defs/nodeCountRange" },
            "TREASURE": { "$ref": "#/$defs/nodeCountRange" }, "UNKNOWN": { "$ref": "#/$defs/nodeCountRange" },
            "BOSS": { "$ref": "#/$defs/nodeCountRange" }
          }
        },
        "route_examples": { "type": "array", "maxItems": 5, "items": {
          "type": "object", "additionalProperties": false, "required": ["criteria", "counts", "nodes"],
          "properties": {
            "criteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["fewest_known_elites", "most_known_elites", "most_rest_sites", "most_shops", "most_normal_fights"] } },
            "counts": { "type": "object", "additionalProperties": false, "required": ["MONSTER", "ELITE", "REST_SITE", "SHOP", "TREASURE", "UNKNOWN", "BOSS"],
              "properties": {
                "MONSTER": { "type": "integer", "minimum": 0 }, "ELITE": { "type": "integer", "minimum": 0 },
                "REST_SITE": { "type": "integer", "minimum": 0 }, "SHOP": { "type": "integer", "minimum": 0 },
                "TREASURE": { "type": "integer", "minimum": 0 }, "UNKNOWN": { "type": "integer", "minimum": 0 }, "BOSS": { "type": "integer", "minimum": 0 }
              } },
            "nodes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["col", "row", "type"],
              "properties": { "col": { "type": "integer" }, "row": { "type": "integer" }, "type": { "type": "string" } } } }
          }
        } },
        "minimum_elite_route_example": {
          "oneOf": [{ "type": "null" }, {
            "type": "object", "additionalProperties": false, "required": ["known_elites", "nodes"],
            "properties": {
              "known_elites": { "type": "integer", "minimum": 0 },
              "nodes": { "type": "array", "minItems": 1, "items": {
                "type": "object", "additionalProperties": false, "required": ["col", "row", "type"],
                "properties": { "col": { "type": "integer" }, "row": { "type": "integer" }, "type": { "type": "string" } }
              } }
            }
          }]
        },
        "known_elite_required_to_reach_boss": { "type": ["boolean", "null"], "description": "Whether every visible graph route to the first boss contains an ELITE node. Null means no known route reaches that boss. UNKNOWN encounters remain unresolved; future movement effects are not predicted." }
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text_ref"
          ],
          "additionalProperties": false,
          "properties": {
            "text_ref": {
              "type": "string",
              "pattern": "^(rule_|t)[0-9]+$"
            }
          }
        }
      ]
    },
    "coord": {
      "type": "object",
      "required": [
        "col",
        "row"
      ],
      "properties": {
        "col": {
          "type": "integer"
        },
        "row": {
          "type": "integer"
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "cost"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "cost": {
          "type": "number"
        }
      }
    },
    "cardGroup": {
      "type": "object",
      "required": [
        "card",
        "count",
        "instance_ids"
      ],
      "properties": {
        "card": {
          "$ref": "#/$defs/card"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "instance_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "records": {
      "oneOf": [
        {
          "type": "array"
        },
        {
          "$ref": "#/$defs/recordTable"
        }
      ]
    },
    "recordTable": {
      "type": "object",
      "required": [
        "encoding",
        "layouts",
        "rows"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "record_table_v1",
            "record_table_v2",
            "record_table_v3"
          ]
        },
        "layouts": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "required": [
                  "constants",
                  "fields"
                ],
                "properties": {
                  "constants": {
                    "anyOf": [
                      {
                        "type": "object"
                      },
                      {
                        "type": "array"
                      }
                    ]
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}
