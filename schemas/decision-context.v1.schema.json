{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jev-sts2-agent:decision-context:v1",
  "title": "STS2 self-contained Jev decision context",
  "description": "The value sent as TypeSafe state. Every request contains all referenced text and all offered action parameters. Version changes require explicit migration.",
  "type": "object",
  "required": [
    "schema_version",
    "objective",
    "screen",
    "in_combat",
    "run",
    "player",
    "resources",
    "deck",
    "map",
    "combat",
    "screen_state",
    "memory",
    "rules",
    "information",
    "legal_actions"
  ],
  "additionalProperties": false,
  "properties": {
    "turn_plan": {
      "type": ["object", "null"],
      "required": ["source", "revision", "turn", "objective", "status", "next_step", "ordered_steps"],
      "properties": {
        "source": { "$ref": "#/$defs/text" },
        "revision": { "type": "integer", "minimum": 0 },
        "turn": { "type": "integer", "minimum": 0 },
        "objective": { "type": "object", "required": ["id", "meaning"], "properties": { "id": { "type": "string" }, "meaning": { "$ref": "#/$defs/text" } } },
        "status": { "enum": ["active", "awaiting_selection", "needs_review", "completed", "outcome_unknown"] },
        "next_step": { "type": "integer", "minimum": 0 },
        "ordered_steps": { "type": "array", "items": {
          "type": "object", "required": ["sequence", "kind", "role", "status"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 0 },
            "kind": { "enum": ["play_card", "use_potion", "end_turn"] },
            "role": { "enum": ["payoff", "preparation", "finish_turn"] },
            "status": { "enum": ["confirmed", "intended"] }
          }
        } }
      }
    },
    "turn_planning": { "type": "object", "required": ["phase_scope", "energy_reservation"], "properties": {
      "phase_scope": { "$ref": "#/$defs/text" },
      "conditional_projection": { "oneOf": [{ "$ref": "#/$defs/turnProjection" }, { "type": "array", "maxItems": 0 }] },
      "energy_reservation": { "type": "object", "additionalProperties": false, "required": ["observed_energy", "remaining_after_printed_costs", "scope", "is_observed", "includes_future_energy_gains", "steps"], "properties": {
        "observed_energy": { "type": "integer", "minimum": 0 },
        "remaining_after_printed_costs": { "type": "integer" },
        "is_observed": { "type": "boolean" },
        "includes_future_energy_gains": { "const": false },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/energyTransition" } },
        "scope": { "$ref": "#/$defs/text" }
      } }
    } },
    "decision_brief": { "type": ["object", "null"] },
    "rule_reference": {
      "type": ["object", "null"],
      "properties": {
        "source": { "$ref": "#/$defs/text" },
        "game_version": { "type": "string" },
        "scope": { "$ref": "#/$defs/text" },
        "entries": { "type": "object" }
      }
    },
    "strategy_assessment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source", "priority", "meaning"],
          "properties": {
            "source": { "$ref": "#/$defs/text" },
            "priority": { "enum": ["reliable_defense", "efficient_damage", "multi_target_damage", "sustained_scaling", "draw_consistency", "energy_support", "immediate_recovery", "preserve_quality"] },
            "meaning": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "required": ["source", "scale", "options"],
          "properties": {
            "source": { "$ref": "#/$defs/text" },
            "scale": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/text" } },
            "options": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "required": ["action_id", "score"],
                "properties": {
                  "action_id": { "type": "string", "minLength": 1 },
                  "score": { "type": "number", "minimum": 0, "maximum": 3 },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                  "probabilities": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
                }
              }
            }
          }
        }
      ]
    },
    "schema_version": {
      "const": "sts2.decision.v1"
    },
    "objective": {
      "type": "object",
      "required": [
        "strategy",
        "execution_checkpoint"
      ],
      "properties": {
        "strategy": {
          "$ref": "#/$defs/text"
        },
        "execution_checkpoint": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "screen": {
      "type": "string"
    },
    "in_combat": {
      "type": "boolean"
    },
    "run": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "run_id",
            "combat_id",
            "act_index",
            "act_floor",
            "total_floor",
            "ascension",
            "game_mode",
            "modifiers"
          ],
          "properties": {
            "run_id": {
              "type": "string"
            },
            "combat_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "act_index": {
              "type": "integer",
              "minimum": 0
            },
            "act_floor": {
              "type": "integer",
              "minimum": 0
            },
            "total_floor": {
              "type": "integer",
              "minimum": 0
            },
            "ascension": {
              "type": "integer",
              "minimum": 0
            },
            "game_mode": {
              "type": "string"
            },
            "modifiers": {
              "type": "array"
            }
          }
        }
      ]
    },
    "player": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "hp",
            "max_hp",
            "gold",
            "deck_count",
            "relics",
            "potions",
            "powers"
          ],
          "properties": {
            "hp": {
              "type": "number"
            },
            "max_hp": {
              "type": "number"
            },
            "gold": {
              "type": "number"
            },
            "deck_count": {
              "type": "integer",
              "minimum": 0
            },
            "relics": {
              "type": "array"
            },
            "potions": {
              "type": "array"
            },
            "powers": {
              "type": "array"
            }
          }
        }
      ]
    },
    "resources": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "potion_capacity"
          ],
          "properties": {
            "potion_capacity": {
              "type": "integer",
              "minimum": 0
            },
            "potion_effects": { "type": "array", "items": { "$ref": "#/$defs/potionEffect" } }
          }
        }
      ]
    },
    "deck": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "count",
            "cards",
            "kind"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "cards": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/cardGroup"
                  }
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "kind": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "map": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "act_index",
            "nodes"
          ],
          "dependentRequired": {
            "legal_next_nodes": ["routes", "route_semantics"],
            "routes": ["legal_next_nodes", "route_semantics"]
          },
          "properties": {
            "act_index": {
              "type": "integer"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "col",
                  "row",
                  "type",
                  "children"
                ],
                "properties": {
                  "col": {
                    "type": "integer"
                  },
                  "row": {
                    "type": "integer"
                  },
                  "type": {
                    "type": "string"
                  },
                  "children": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/coord"
                    }
                  }
                }
              }
            },
            "legal_next_nodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/coord"
              }
            },
            "routes": {
              "type": "array",
              "items": { "$ref": "#/$defs/mapRoute" }
            },
            "route_semantics": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "combat": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "hand",
            "draw_pile",
            "discard_pile",
            "exhaust_pile",
            "play_pile",
            "enemies",
            "history",
            "history_coverage"
          ],
          "properties": {
            "hand": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/card"
                  }
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "draw_pile": {
              "type": "object",
              "required": [
                "order",
                "cards"
              ],
              "properties": {
                "order": {
                  "const": "unknown"
                },
                "cards": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/cardGroup"
                      }
                    },
                    {
                      "$ref": "#/$defs/recordTable"
                    }
                  ]
                }
              }
            },
            "discard_pile": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/card"
                  }
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "exhaust_pile": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/card"
                  }
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "play_pile": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/card"
                  }
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "enemies": {
              "oneOf": [
                {
                  "type": "array"
                },
                {
                  "$ref": "#/$defs/recordTable"
                }
              ]
            },
            "history": {
              "$ref": "#/$defs/records"
            },
            "history_coverage": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "screen_state": {
      "type": "object",
      "description": "Exact current menu, event, shop, reward or selection DTO, including offered effects and selection constraints."
    },
    "memory": {
      "type": "object",
      "required": [
        "coverage",
        "actions",
        "observations"
      ],
      "properties": {
        "coverage": {
          "$ref": "#/$defs/text"
        },
        "actions": {
          "$ref": "#/$defs/records"
        },
        "observations": {
          "$ref": "#/$defs/records"
        },
        "relic_updates": {
          "$ref": "#/$defs/records"
        },
        "pending": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "$ref": "#/$defs/text"
          },
          "description": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "information": {
      "type": "object",
      "required": [
        "source",
        "unknown",
        "card_grouping",
        "extraction_errors"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/text"
        },
        "unknown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "card_grouping": {
          "$ref": "#/$defs/text"
        },
        "extraction_errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "legal_actions": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action_id",
              "request",
              "description"
            ],
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "$ref": "#/$defs/text"
              },
              "card_hand_index": {
                "type": "integer",
                "minimum": 0
              },
              "target_combat_id": {
                "type": "integer",
                "minimum": 0
              },
              "planning_choice": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "count"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "count"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "card_index"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "card"
                      },
                      "card_index": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                ]
              },
              "request": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "cmd"
                ],
                "properties": {
                  "cmd": {
                    "type": "string",
                    "pattern": "^[a-z][a-z_]*$"
                  }
                }
              }
            }
          }
        },
        {
          "$ref": "#/$defs/recordTable"
        }
      ]
    },
    "text_dictionary": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "turnProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["calculation_status", "fully_simulated", "known_effects_only", "omitted_effects", "interpretation", "scope"],
      "properties": {
        "calculation_status": { "enum": ["incomplete", "preview_arithmetic"] },
        "fully_simulated": { "const": false },
        "known_effects_only": {
          "type": "object", "additionalProperties": false,
          "required": ["block", "hp_if_ending", "hp_loss_if_ending", "block_including_end_turn_gains", "end_turn_block_gains", "incoming_attack", "enemies"],
          "properties": {
            "block": { "type": "number" }, "hp_if_ending": { "type": "number" }, "hp_loss_if_ending": { "type": "number" },
            "block_including_end_turn_gains": { "type": "number" }, "incoming_attack": { "type": "number" },
            "end_turn_block_gains": { "type": "array", "items": {
              "type": "object", "required": ["source_id", "amount", "timing"],
              "properties": { "source_id": { "type": "string" }, "amount": { "type": "number", "minimum": 0 }, "timing": { "type": "string" } }
            } },
            "enemies": { "type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["combat_id", "hp", "block", "hp_removed", "block_removed"],
              "properties": {
                "combat_id": { "type": "integer" }, "hp": { "type": "number" }, "block": { "type": "number" },
                "hp_removed": { "type": "number" }, "block_removed": { "type": "number" }
              }
            } }
          }
        },
        "omitted_effects": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "interpretation": { "$ref": "#/$defs/text" }, "scope": { "$ref": "#/$defs/text" }
      }
    },
    "potionEffect": {
      "type": "object", "additionalProperties": false,
      "required": ["potion_id", "slot", "power_id", "amount", "duration", "expires_at", "can_be_changed_or_removed", "affected_quantity", "application_unit", "applied_before_multipliers", "affects_prior_actions", "direct_damage", "direct_block", "requires_followup_actions", "unpowered_effects_excluded", "source"],
      "properties": {
        "potion_id": { "enum": ["STRENGTH_POTION", "DEXTERITY_POTION", "FLEX_POTION", "SPEED_POTION"] },
        "slot": { "type": "integer", "minimum": 0 },
        "power_id": { "enum": ["STRENGTH_POWER", "DEXTERITY_POWER"] },
        "amount": { "type": "integer", "minimum": 0 },
        "duration": { "enum": ["combat", "turn"] },
        "expires_at": { "enum": ["combat_end", "owner_turn_end"] },
        "can_be_changed_or_removed": { "const": true },
        "affected_quantity": { "enum": ["powered_attack_damage", "powered_block_gain"] },
        "application_unit": { "enum": ["each_damage_instance", "each_block_gain"] },
        "applied_before_multipliers": { "const": true },
        "affects_prior_actions": { "const": false },
        "direct_damage": { "const": 0 },
        "direct_block": { "const": 0 },
        "requires_followup_actions": { "const": true },
        "unpowered_effects_excluded": { "const": true },
        "source": { "$ref": "#/$defs/text" }
      }
    },
    "energyTransition": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "kind", "hand_index", "energy_before", "reserved_cost", "energy_after", "affordable"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["play_card", "use_potion", "end_turn"] },
        "hand_index": { "type": ["integer", "null"], "minimum": 0 },
        "energy_before": { "type": "integer" },
        "reserved_cost": { "type": "integer", "minimum": 0 },
        "energy_after": { "type": "integer" },
        "affordable": { "type": "boolean" }
      }
    },
    "nodeCountRange": {
      "type": "object", "additionalProperties": false, "required": ["min", "max"],
      "properties": { "min": { "type": "integer", "minimum": 0 }, "max": { "type": "integer", "minimum": 0 } }
    },
    "mapRoute": {
      "type": "object", "additionalProperties": false,
      "required": ["next_node", "reachable_node_count", "nearest_steps_after_chosen_node", "reaches_boss", "counts", "minimum_elite_route_example", "known_elite_required_to_reach_boss"],
      "properties": {
        "next_node": { "$ref": "#/$defs/coord" },
        "reachable_node_count": { "type": "integer", "minimum": 1 },
        "nearest_steps_after_chosen_node": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "reaches_boss": { "type": "boolean" },
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["MONSTER", "ELITE", "REST_SITE", "SHOP", "TREASURE", "UNKNOWN", "BOSS"],
          "properties": {
            "MONSTER": { "$ref": "#/$defs/nodeCountRange" }, "ELITE": { "$ref": "#/$defs/nodeCountRange" },
            "REST_SITE": { "$ref": "#/$defs/nodeCountRange" }, "SHOP": { "$ref": "#/$defs/nodeCountRange" },
            "TREASURE": { "$ref": "#/$defs/nodeCountRange" }, "UNKNOWN": { "$ref": "#/$defs/nodeCountRange" },
            "BOSS": { "$ref": "#/$defs/nodeCountRange" }
          }
        },
        "minimum_elite_route_example": {
          "oneOf": [{ "type": "null" }, {
            "type": "object", "additionalProperties": false, "required": ["known_elites", "nodes"],
            "properties": {
              "known_elites": { "type": "integer", "minimum": 0 },
              "nodes": { "type": "array", "minItems": 1, "items": {
                "type": "object", "additionalProperties": false, "required": ["col", "row", "type"],
                "properties": { "col": { "type": "integer" }, "row": { "type": "integer" }, "type": { "type": "string" } }
              } }
            }
          }]
        },
        "known_elite_required_to_reach_boss": { "type": ["boolean", "null"], "description": "Whether every visible graph route to the first boss contains an ELITE node. Null means no known route reaches that boss. UNKNOWN encounters remain unresolved; future movement effects are not predicted." }
      }
    },
    "text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text_ref"
          ],
          "additionalProperties": false,
          "properties": {
            "text_ref": {
              "type": "string",
              "pattern": "^(rule_|t)[0-9]+$"
            }
          }
        }
      ]
    },
    "coord": {
      "type": "object",
      "required": [
        "col",
        "row"
      ],
      "properties": {
        "col": {
          "type": "integer"
        },
        "row": {
          "type": "integer"
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "cost"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "cost": {
          "type": "number"
        }
      }
    },
    "cardGroup": {
      "type": "object",
      "required": [
        "card",
        "count",
        "instance_ids"
      ],
      "properties": {
        "card": {
          "$ref": "#/$defs/card"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "instance_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "records": {
      "oneOf": [
        {
          "type": "array"
        },
        {
          "$ref": "#/$defs/recordTable"
        }
      ]
    },
    "recordTable": {
      "type": "object",
      "required": [
        "encoding",
        "layouts",
        "rows"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "record_table_v1",
            "record_table_v2",
            "record_table_v3"
          ]
        },
        "layouts": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "required": [
                  "constants",
                  "fields"
                ],
                "properties": {
                  "constants": {
                    "anyOf": [
                      {
                        "type": "object"
                      },
                      {
                        "type": "array"
                      }
                    ]
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
